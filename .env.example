# --- Required ---
# Discord BOT token (not a user token). Create an application + bot at
# https://discord.com/developers/applications and copy its token here.
BOT_TOKEN=

# --- Optional behaviour ---
# Join voice channels and play a TTS greeting for each member who joins.
ENABLE_GREETINGS=false

# Play the bundled hello chime when the bot first connects to a channel.
JOIN_CHIME=true

# --- Text-to-speech (only used when ENABLE_GREETINGS=true) ---
# edge-tts neural voice. Ukrainian options: uk-UA-PolinaNeural, uk-UA-OstapNeural
TTS_VOICE=uk-UA-PolinaNeural
# Greeting text; {name} is replaced with the joining member's display name.
TTS_GREETING_TEMPLATE=Нова видрочка {name} приєдналась!

# --- Misc ---
# Legacy text-command prefix (no text commands are defined yet).
COMMAND_PREFIX=!
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
