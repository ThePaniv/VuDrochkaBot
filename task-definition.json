{
  "family": "vudrochka-bot",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::126568927381:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "vudrochka-bot",
      "image": "126568927381.dkr.ecr.eu-central-1.amazonaws.com/vudrochka-bot:latest",
      "essential": true,
      "stopTimeout": 30,
      "environment": [
        { "name": "ENABLE_GREETINGS", "value": "false" },
        { "name": "JOIN_CHIME", "value": "true" },
        { "name": "TTS_VOICE", "value": "uk-UA-PolinaNeural" },
        { "name": "LOG_LEVEL", "value": "INFO" }
      ],
      "secrets": [
        {
          "name": "BOT_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:126568927381:secret:vudrochka-bot/BOT_TOKEN"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-create-group": "true",
          "awslogs-group": "/ecs/vudrochka-bot",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
